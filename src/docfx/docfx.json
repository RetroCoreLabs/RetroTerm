{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "RetroTerm.Core.Protocols/RetroTerm.Core.Protocols.csproj",
            "RetroTerm.Core/RetroTerm.Core.csproj",
            "RetroTerm.Core.Protocols.Net/RetroTerm.Core.Protocols.Net.csproj",
            "RetroTerm.Core.Protocols.WebSocket/RetroTerm.Core.Protocols.WebSocket.csproj",
            "RetroTerm.Core.Protocols.TelnetServer/RetroTerm.Core.Protocols.TelnetServer.csproj",
            "RetroTerm.Core.Protocols.Kermit/RetroTerm.Core.Protocols.Kermit.csproj",
            "RetroTerm.Mcp/RetroTerm.Mcp.csproj",
            "RetroTerm.Desktop/RetroTerm.Desktop.csproj"
          ],
          "exclude": [
            "**/*.Tests/**",
            "**/tests/**",
            "**/tools/**",
            "**/obj/**",
            "**/bin/**"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "nested",
      "memberLayout": "samePage",
      "allowCompilationErrors": false,
      "outputFormat": "mref"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "*.md",
          "toc.yml"
        ],
        "exclude": [
          "README.md"
        ]
      },
      {
        "_comment": "GENERATED by gen_toc.py from `git ls-files` and the policy in that script: the reference documents and the transcribed manuals. Plans, bug lists, dated reviews and the run sheets stay on GitHub. Do not edit this list by hand; run the script.",
        "files": [
          "docs/DISTRIBUTION-README.md",
          "docs/KBD-ND-246.md",
          "docs/LOGO-DESIGN-GUIDE.md",
          "docs/MCP-AND-SCRIPTING.md",
          "docs/ND100-GATEWAY.md",
          "docs/ND110-OPCOM-MICROCODE-REFERENCE.md",
          "docs/OPCOM-COMMAND-REFERENCE.md",
          "docs/TDV-KEYBOARD-COMPLETE-REFERENCE.md",
          "docs/TDV-MODES-AND-REPORTS-FROM-THE-MANUALS.md",
          "docs/spec/DEC_VT_Validation.md",
          "docs/spec/ECMA/ECMA-48_5th_edition_june_1991.md",
          "docs/spec/Keyboards/KeyBoard-Size-ND246.md",
          "docs/spec/Keyboards/keyboard-spec.md",
          "docs/spec/TDV1200/ND-12045-2-EN_combined.md",
          "docs/spec/TDV1200/ND-12045.1 EN ND Display Terminal 1200 User Guide-Gandalf-OCR_combined.md",
          "docs/spec/TDV1200/ND-12054-1-EN_combined.md",
          "docs/spec/TDV1200/nd_1200_graphics_protocol.md",
          "docs/spec/TDV1200/tdv_1200_graphics_library_extended.md",
          "docs/spec/TDV2115/TDV2115.md",
          "docs/spec/TDV2200/DOC TDV2200/keyboard_documentation.md",
          "docs/spec/TDV2200/OCR/TDV-2200_9-User-s_Guide-ND_combined.md",
          "docs/spec/TDV2200/OCR/TDV-391170-0-EN_combined.md",
          "docs/spec/TDV2200/OCR/TDV-392894-0-EN_combined.md",
          "docs/spec/TDV2200/OCR/TDV-397262-4-EN_combined.md",
          "docs/spec/TDV2200/Term and keyboard info/TDV-Keys.md",
          "docs/spec/TDV2200/Term and keyboard info/TDV1200-deep.md",
          "docs/spec/TDV2200/Term and keyboard info/TDV1200.md",
          "docs/spec/TDV2200/Term and keyboard info/TDV2200.md",
          "docs/spec/TDV2200/Testing2200_9S/character_processing_renames.md",
          "docs/spec/TDV2200/Testing2200_9S/memory_variables_renamed.md",
          "docs/spec/TDV2200/Testing2200_9S/nd_csi_sequences.md",
          "docs/spec/TDV2200/Testing2200_9S/nd_terminal_analysis_updated.md",
          "docs/spec/TDV2200/Testing2200_9S/tdv2200_escape_sequence_table.md",
          "docs/spec/TDV2200/Testing2215/complete_nvram_analysis.md",
          "docs/spec/TDV2200/Testing2215/complete_serial_documentation.md",
          "docs/spec/TDV2200/Testing2215/control_char_handlers_analysis.md",
          "docs/spec/TDV2200/Testing2215/control_dispatch_table_analysis.md",
          "docs/spec/TDV2200/Testing2215/cr_lf_processing_analysis.md",
          "docs/spec/TDV2200/Testing2215/display_io_analysis.md",
          "docs/spec/TDV2200/Testing2215/nvram_complete_documentation.md",
          "docs/spec/TDV2200/Testing2215/nvram_memory_map.md",
          "docs/spec/TDV2200/Testing2215/tdv2115_control_sequences.md",
          "docs/spec/TDV2200/Testing2215/tdv2215_8253_sio_clocking.md",
          "docs/spec/TDV2200/Testing2215/tdv2215_analysis.md",
          "docs/spec/TDV2200/Testing2215/tdv2215_complete_analysis.md",
          "docs/spec/TDV2200/Testing2215/tdv2215_display_rendering_analysis.md",
          "docs/spec/TDV2200/Testing2215/tdv2215_escape_sequences.md",
          "docs/spec/TDV2200/Testing2215/tdv2215_interrupt_analysis.md",
          "docs/spec/TDV2200/Testing2215/tdv2215_restart_debug.md",
          "docs/spec/TDV2200/Testing2215/tdv2215_selftest_debug.md",
          "docs/spec/TDV2215/TDV2215-vs.md",
          "docs/spec/TDV2215/TDV2215.md",
          "docs/spec/Tektronix/nd-graphic-terminal-analysis.md",
          "docs/spec/Tektronix/retroterm-nd-graphics-plan.md"
        ],
        "src": "../..",
        "dest": ""
      }
    ],
    "resource": [
      {
        "files": [
          "docs/**.png",
          "docs/**.jpg",
          "docs/**.jpeg",
          "docs/**.gif",
          "docs/**.bmp",
          "docs/**.svg"
        ],
        "exclude": [
          "docs/manual-tests/**"
        ],
        "src": "../..",
        "dest": ""
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "RetroTerm",
      "_appTitle": "RetroTerm",
      "_appFooter": "Copyright (c) 1985-2026 Ronny Hansen - MIT License - RetroCore Labs",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/RetroCoreLabs/RetroTerm",
        "branch": "main"
      }
    },
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The RetroIO packages (RetroIO.Protocols.Tn3270 and what it needs) are published to GitHub Packages
         by RetroIO's v* tag workflow. GitHub Packages asks for a login even to read a public package, so
         the two values below come from the environment: in the workflow the build's own token, on a
         PC a personal token with the read:packages scope. They are never written into this file. -->
    <add key="retrocorelabs" value="https://nuget.pkg.github.com/retrocorelabs/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <retrocorelabs>
      <add key="Username" value="%RETROCORE_NUGET_USER%" />
      <add key="ClearTextPassword" value="%RETROCORE_NUGET_TOKEN%" />
    </retrocorelabs>
  </packageSourceCredentials>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local folder feed beside the repositories, filled by RetroIO's src\eng\publish-local.ps1
         (0.1.0-local.*), used while the RetroIO packages are not on a public feed. A floating
         version is picked at restore: after a new pack, restore again with the force-evaluate option (two dashes cannot be written inside an XML comment). -->
    <add key="local" value="..\..\localfeed" />
  </packageSources>
</configuration>

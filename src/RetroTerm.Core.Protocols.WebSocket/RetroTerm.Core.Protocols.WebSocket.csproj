<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RetroTerm.Core.Protocols\RetroTerm.Core.Protocols.csproj" />
    <!-- GatewayCommand implements ISessionCommand (Core.Commands) against a
         TerminalSession (Core.Session). Core is the base layer; no cycle. -->
    <ProjectReference Include="..\RetroTerm.Core\RetroTerm.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Raw Ethernet capture for the gateway's "host adapter" mapping. Needs npcap on
         Windows at RUN time; the package itself builds and restores anywhere, and a
         missing driver leaves that one mapping inactive rather than breaking the app. -->
    <PackageReference Include="SharpPcap" Version="6.3.1" />
  </ItemGroup>

</Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RetroTerm.Desktop.Views.KeyboardReferenceWindow"
        Title="Keyboard Reference"
        Width="700"
        Height="600"
        Background="#252526"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <DockPanel>
        <!-- Title Bar -->
        <Border DockPanel.Dock="Top"
                Background="#2D2D30"
                BorderBrush="#3C3C3C"
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <StackPanel>
                <TextBlock Name="WindowTitle"
                           Text="Keyboard Reference - TDV 2200"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#CCCCCC"/>
                <TextBlock Text="Special key mappings and escape sequences"
                           FontSize="11"
                           Foreground="#999999"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Close Button -->
        <Border DockPanel.Dock="Bottom"
                Background="#2D2D30"
                BorderBrush="#3C3C3C"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Button Content="Close"
                    Click="OnCloseClick"
                    HorizontalAlignment="Right"
                    Classes="Primary"/>
        </Border>

        <!-- Tab Control -->
        <TabControl Margin="0"
                    Background="#252526"
                    BorderThickness="0">

            <!-- Application Control Keys Tab -->
            <TabItem Header="Application">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="Application Control Keys"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,15"/>

                        <Grid Name="ApplicationKeysGrid" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Editing Keys Tab -->
            <TabItem Header="Editing">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="PC keys that reach a TDV key"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,15"/>

                        <Grid Name="EditingKeysGrid" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PUSH Keys Tab -->
            <TabItem Header="PUSH Keys">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="Programmable Function Keys"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Alt+1 to Alt+8 or Alt+F1 to Alt+F8 send PUSH 1 to 8; Alt+Shift+F1 to F8 send PUSH 9 to 16"
                                   FontSize="11"
                                   Foreground="#999999"
                                   Margin="0,0,0,15"/>

                        <Grid Name="PushKeysGrid" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Navigation Keys Tab -->
            <TabItem Header="Navigation">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="Fixed keys - one byte in every mode"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,15"/>

                        <Grid Name="NavigationKeysGrid" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

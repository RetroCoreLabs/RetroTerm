<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RetroTerm.Desktop.Views"
        x:Class="RetroTerm.Desktop.Views.ProtocolMonitorWindow"
        Title="Protocol Monitor"
        Width="1180" Height="700"
        Background="{DynamicResource ControlBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ToggleButton Name="CaptureToggle"
                              Content="Capturing"
                              IsChecked="True"
                              Click="OnCaptureToggled"
                              Padding="10,4"
                              Cursor="Hand"
                              ToolTip.Tip="Pause or resume protocol capture"/>

                <Button Classes="Primary" Name="CopyAllButton"
                        Content="Copy All"
                        Click="OnCopyAllClick"
                        Padding="10,4"
                        ToolTip.Tip="Copy every visible decoded line"/>

                <Button Classes="Primary" Name="CopySelectedButton"
                        Content="Copy Selected"
                        Click="OnCopySelectedClick"
                        Padding="10,4"
                        ToolTip.Tip="Copy only the selected lines (Ctrl+C). Shift/Ctrl click to multi-select."/>

                <Button Classes="Secondary" Name="ClearButton"
                        Content="Clear"
                        Click="OnClearClick"
                        Padding="10,4"/>

                <Button Classes="Secondary" Name="SaveButton"
                        Content="Save Trace..."
                        Click="OnSaveClick"
                        Padding="10,4"
                        ToolTip.Tip="Write the whole trace to %AppData%\RetroTerm\logs\"/>

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2"/>

                <CheckBox Name="ShowRxCheck" Content="RX" IsChecked="True" Click="OnFilterChanged" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip.Tip="Host to terminal"/>
                <CheckBox Name="ShowTxCheck" Content="TX" IsChecked="True" Click="OnFilterChanged" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip.Tip="Terminal to host"/>

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2"/>

                <CheckBox Name="ShowTextCheck" Content="Text" IsChecked="True" Click="OnFilterChanged" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip.Tip="Printable character runs"/>
                <CheckBox Name="ShowControlCheck" Content="Ctrl" IsChecked="True" Click="OnFilterChanged" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip.Tip="C0 control characters"/>
                <CheckBox Name="ShowSequenceCheck" Content="Esc/CSI" IsChecked="True" Click="OnFilterChanged" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <CheckBox Name="UnknownOnlyCheck" Content="Unknown only" IsChecked="False" Click="OnFilterChanged" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip.Tip="Show only sequences the decoder did not recognise"/>

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2"/>

                <CheckBox Name="ShowHexCheck" Content="Hex" IsChecked="True" Click="OnFilterChanged" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip.Tip="Show the raw bytes column"/>
                <CheckBox Name="FollowCheck" Content="Follow" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBox Name="SearchBox"
                         Width="170"
                         PlaceholderText="Search..."
                         TextChanged="OnSearchChanged"
                         VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <TextBlock Name="StatusText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11"/>
        </Border>

        <Grid ColumnDefinitions="2.2*,4,1*">
            <!-- Left: decoded sequence list -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        Padding="8,3">
                    <TextBlock Text="Decoded stream"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>

                <ListBox Name="DecodedListBox"
                         SelectionMode="Multiple"
                         Background="{DynamicResource SectionBackgroundBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:LogLineRow">
                            <TextBlock Text="{Binding Text}"
                                       Foreground="{Binding Brush}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="11"
                                       TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="6,0"/>
                            <Setter Property="MinHeight" Value="16"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Background="{DynamicResource BorderBrush}"
                          ResizeDirection="Columns"/>

            <!-- Right: raw network blocks -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        Padding="8,3">
                    <TextBlock Text="Raw blocks"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>

                <ListBox Name="RawListBox"
                         SelectionMode="Multiple"
                         Background="{DynamicResource SectionBackgroundBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:LogLineRow">
                            <TextBlock Text="{Binding Text}"
                                       Foreground="{Binding Brush}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="6,1"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:RetroTerm.Desktop.Controls"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="350"
        x:Class="RetroTerm.Desktop.Views.VirtualKeyboardWindow"
        Title="TDV2200 Virtual Keyboard"
        Width="900"
        Height="350"
        MinWidth="600"
        MinHeight="250"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <!-- ONE window for every terminal (Ronny, 22 November 2026). The TDV panel shows for a TDV
         tab; a terminal that brings its own keyboard descriptions (the IBM 3270) shows the shared
         drawing control instead, with a choice between its keyboards. The TDV panel moves onto the
         shared control in a later stage of docs\PLAN.md. -->
    <Panel>
        <controls:VirtualKeyboardPanel Name="VirtualKeyboard" />
        <StackPanel Name="DescribedPanel" IsVisible="False" Margin="8" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Keyboard:" VerticalAlignment="Center" />
                <ComboBox Name="DescribedChoice" MinWidth="260" />
            </StackPanel>
            <controls:DescribedKeyboardView Name="DescribedKeyboard" HorizontalAlignment="Left" />
        </StackPanel>
    </Panel>

</Window>

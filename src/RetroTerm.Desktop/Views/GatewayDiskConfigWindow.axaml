<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RetroTerm.Desktop.Views.GatewayDiskConfigWindow"
        Title="Gateway Disk Images"
        Width="700" Height="520"
        Background="{DynamicResource ControlBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="550" MinHeight="380">
    <DockPanel Margin="16">
        <!-- Title -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Gateway Disk Images"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Classes="Primary" Content="Apply"
                    Click="OnApplyClick"
                    Padding="20,6"/>
            <Button Classes="Secondary" Content="Cancel"
                    Click="OnCancelClick"
                    Padding="20,6"/>
        </StackPanel>

        <!-- Tabs for SMD / Floppy -->
        <TabControl Background="{DynamicResource ControlBackgroundBrush}"
                    Foreground="{DynamicResource PrimaryTextBrush}">
            <TabItem Header="SMD Drives" Foreground="{DynamicResource PrimaryTextBrush}">
                <DockPanel Margin="0,8,0,0">
                    <Button Classes="AddAction" DockPanel.Dock="Bottom"
                            Name="AddSmdButton"
                            Content="+ Add SMD Image"
                            Click="OnAddSmdClick"
                            HorizontalAlignment="Left"
                            Padding="12,5"
                            Margin="0,8,0,0"
                            FontSize="12"/>
                    <Border Background="{DynamicResource SectionBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="SmdPanel" Spacing="1"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>
            <TabItem Header="Floppy Drives" Foreground="{DynamicResource PrimaryTextBrush}">
                <DockPanel Margin="0,8,0,0">
                    <Button Classes="AddAction" DockPanel.Dock="Bottom"
                            Name="AddFloppyButton"
                            Content="+ Add Floppy Image"
                            Click="OnAddFloppyClick"
                            HorizontalAlignment="Left"
                            Padding="12,5"
                            Margin="0,8,0,0"
                            FontSize="12"/>
                    <Border Background="{DynamicResource SectionBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="FloppyPanel" Spacing="1"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
